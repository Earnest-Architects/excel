{
  "name": "Excel ビューア",
  "short_name": "Excel ビューア",
  "description": "ブラウザでExcelファイルを表示・印刷",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f2",
  "theme_color": "#0f6b3a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel.sheet.macroEnabled.12": [
          ".xlsm"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ]
}